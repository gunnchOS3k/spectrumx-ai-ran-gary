{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gunnchos:research:p4:fair-control:config:0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "status",
    "authorization",
    "policies",
    "compute",
    "heldout",
    "analysis",
    "pending_decisions"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "experiment_id": {
      "const": "paper-ii-p4-fair-control-draft"
    },
    "status": {
      "const": "DESIGN_DRAFT_ENGINEERING_ONLY"
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_execution",
        "publication"
      ],
      "properties": {
        "campaign_execution": {
          "const": false
        },
        "publication": {
          "const": false
        }
      }
    },
    "policies": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "observations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "observations": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6,
            "uniqueItems": true,
            "items": {
              "enum": [
                "timestamp_s",
                "estimated_paths",
                "task_queue",
                "remaining_energy_j",
                "previous_action",
                "forecasts"
              ]
            }
          }
        }
      }
    },
    "compute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_model_evaluations",
        "deadline_s"
      ],
      "properties": {
        "max_model_evaluations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "deadline_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.1
        }
      }
    },
    "heldout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed_ids",
        "outcome_paths"
      ],
      "properties": {
        "seed_ids": {
          "type": "null"
        },
        "outcome_paths": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_unit",
        "practical_effect",
        "target_half_width",
        "power",
        "maximum_units"
      ],
      "properties": {
        "primary_unit": {
          "const": "independent_paired_seed_mean"
        },
        "practical_effect": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "target_half_width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "power": {
          "type": "number",
          "exclusiveMinimum": 0.5,
          "exclusiveMaximum": 1
        },
        "maximum_units": {
          "type": "integer",
          "minimum": 30,
          "maximum": 2500
        }
      }
    },
    "pending_decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
